{
  "name": "@qtangl/sdk",
  "version": "0.9.1",
  "description": "Official Qtangl PQC Readiness API client",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "generate": "python ../../scripts/generate_sdk_types.py",
    "build:tsc": "tsc",
    "build": "npm run generate && tsc",
    "test": "npm run build && node --test tests/client.test.mjs",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "keywords": [
    "qtangl",
    "pqc",
    "post-quantum",
    "cryptography",
    "api-client"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/qtangl/qtangl.git",
    "directory": "sdk/typescript"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "openapi-typescript": "^7.6.1",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "web": "file:../../web"
  }
}
