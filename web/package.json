{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate:library": "python ../scripts/build_library_index.py",
    "generate:library-drafts": "python ../scripts/draft_library_editorial.py",
    "learn:stale": "node ../scripts/learn-stale-check.mjs",
    "check:readiness-content": "node ../scripts/check-readiness-content-links.mjs",
    "generate:docs-index": "node scripts/build_docs_index.mjs",
    "test:e2e": "playwright test",
    "test:access": "node --experimental-strip-types --test tests/access-validation.test.mjs",
    "test:readiness-roi": "node --experimental-strip-types --test tests/readiness-roi.test.mjs",
    "prebuild": "npm run generate:library && npm run generate:docs-index",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@types/d3-force": "^3.0.10",
    "d3-force": "^3.0.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
