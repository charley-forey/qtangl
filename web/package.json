{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "pretest:unit": "npm run build:tsc --prefix ../sdk/typescript",
    "test:unit": "node --experimental-strip-types --import ./tests/register.mjs --test tests/*.test.mjs",
    "generate:library": "python ../scripts/build_library_index.py",
    "generate:library-drafts": "python ../scripts/draft_library_editorial.py",
    "learn:stale": "node ../scripts/learn-stale-check.mjs",
    "check:readiness-content": "node ../scripts/check-readiness-content-links.mjs",
    "generate:hndl-exports": "node scripts/generate-hndl-infographic-exports.mjs",
    "generate:learning-diagram-exports": "node scripts/generate-learning-diagram-exports.mjs",
    "indexnow": "node ../scripts/submit-indexnow.mjs --priority",
    "indexnow:sitemap": "node ../scripts/submit-indexnow.mjs --sitemap",
    "generate:docs-index": "node scripts/build_docs_index.mjs",
    "generate:openapi": "node scripts/generate_openapi_artifact.mjs",
    "generate:docs-export": "node scripts/build_docs_export.mjs",
    "check:docs-coverage": "node scripts/check_docs_coverage.mjs",
    "check:docs-orphans": "node scripts/check_docs_orphans.mjs",
    "check:docs-status": "node scripts/check_docs_status.mjs",
    "check:docs": "npm run check:docs-coverage && npm run check:docs-orphans && npm run check:docs-status",
    "check:schema-sync": "node scripts/check_schema_sync.mjs",
    "check:no-demo-pqc-links": "node scripts/check-no-demo-pqc-links.mjs",
    "test:e2e": "playwright test",
    "test:e2e:assess": "playwright test tests/e2e/assess.spec.ts tests/e2e/assess-production.spec.ts --project=chromium",
    "test:access": "node --experimental-strip-types --test tests/access-validation.test.mjs",
    "test:readiness-roi": "node --experimental-strip-types --test tests/readiness-roi.test.mjs",
    "test:assess-config": "node --experimental-strip-types --import ./tests/register.mjs --test tests/assess-config.test.mjs",
    "test:dashboard-errors": "node --experimental-strip-types --import ./tests/register.mjs --test tests/dashboard-errors.test.mjs",
    "test:bff-auth-headers": "node --experimental-strip-types --import ./tests/register.mjs --test tests/bff-auth-headers.test.mjs",
    "generate:pwa-icons": "node scripts/generate-pwa-icons.mjs",
    "optimize:marketing-images": "node scripts/optimize-marketing-images.mjs",
    "generate:comparison-pdf": "node scripts/generate-comparison-guide-pdf.mjs",
    "build:sdk": "npm run build --prefix ../sdk/typescript",
    "build:sdk-react": "npm run build --prefix ../sdk/react",
    "prebuild": "node scripts/prebuild.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@qtangl/sdk": "file:../sdk/typescript",
    "@qtangl/sdk-react": "file:../sdk/react",
    "@types/d3-force": "^3.0.10",
    "@workos-inc/authkit-nextjs": "^2.12.0",
    "d3-force": "^3.0.0",
    "driver.js": "^1.4.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-is": "19.2.4",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "react-is": "19.2.4"
  }
}
