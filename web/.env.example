# Qtangl web environment (copy to `web/.env.local` for dev, or set in Vercel).
# Never commit real secrets. NEXT_PUBLIC_* values are exposed to the browser.

# --- Backend API ---
NEXT_PUBLIC_QTANGL_API_BASE_URL=https://your-api.up.railway.app
NEXT_PUBLIC_QTANGL_SANDBOX_API_KEY=qtangl-demo-key

# --- Access request notifications (/access form) ---
# Email lands in your inbox when someone submits the "request access" form.
# Delivery uses Resend. RESEND_API_KEY is REQUIRED for any email to send —
# without it, submissions are NOT emailed (they only console-log in dev).
RESEND_API_KEY=re_your_resend_key
# charley@qtangl.com is ALWAYS notified even if this is unset. Use a
# comma-separated list to add more recipients (e.g. sales@qtangl.com).
QTANGL_ACCESS_TO_EMAIL=charley@qtangl.com
# Must be a verified sender/domain in your Resend account.
QTANGL_FROM_EMAIL=Qtangl Access <access@qtangl.com>
# Optional: also POST each submission to a webhook (Slack, Zapier, etc.).
# QTANGL_ACCESS_WEBHOOK_URL=
# Alternative to Resend: forward submissions to a Formspree endpoint.
# FORMSPREE_ENDPOINT=
# Dev only — log submissions to the server console when delivery is unset.
# Do NOT set this in production (it makes failed delivery look successful).
# QTANGL_ACCESS_ALLOW_CONSOLE_FALLBACK=true

# --- Analytics (optional) ---
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_DOGFOOD_SCAN_ID=

# --- Dashboard auth (WorkOS) ---
# WORKOS_API_KEY=
# WORKOS_CLIENT_ID=
# WORKOS_WEBHOOK_SECRET=
# WORKOS_COOKIE_PASSWORD=          # 32+ chars — AuthKit session seal
# QTANGL_BFF_SESSION_SECRET=         # shared with backend for BFF → API session headers
# QTANGL_DASHBOARD_AUTH_WORKOS=true
# NEXT_PUBLIC_QTANGL_DASHBOARD_AUTH_WORKOS=true
# QTANGL_DASHBOARD_AUTH_LEGACY_KEY=true
# QTANGL_DASHBOARD_REQUIRE_SSO=false
# QTANGL_ONBOARDING_V2=false

# --- Dashboard SSO / OIDC (deprecated — migrate to WorkOS) ---
# AUTH_OIDC_ISSUER=
# AUTH_OIDC_CLIENT_ID=
# AUTH_OIDC_CLIENT_SECRET=
# AUTH_OIDC_SCOPES=openid profile email
# AUTH_OIDC_DEFAULT_TENANT_ID=sandbox
# AUTH_OIDC_DEFAULT_ROLE=viewer
# AUTH_OIDC_TENANT_MAP=
# AUTH_OIDC_TENANT_API_KEYS=
# QTANGL_DASHBOARD_REQUIRE_SSO=false
# NEXTAUTH_URL=http://localhost:3000
