# WorkOS AuthKit (Vercel — required for dashboard sign-in)
QTANGL_DASHBOARD_AUTH_WORKOS=true
NEXT_PUBLIC_QTANGL_DASHBOARD_AUTH_WORKOS=true
WORKOS_API_KEY=sk_test_...
WORKOS_CLIENT_ID=client_...
WORKOS_COOKIE_PASSWORD=                    # openssl rand -base64 32  (min 32 chars)
NEXT_PUBLIC_WORKOS_REDIRECT_URI=https://www.qtangl.com/auth/callback

# BFF session HMAC — must match Railway backend QTANGL_BFF_SESSION_SECRET
QTANGL_BFF_SESSION_SECRET=

# Public site URL (used when NEXT_PUBLIC_WORKOS_REDIRECT_URI is unset)
NEXTAUTH_URL=https://www.qtangl.com
NEXT_PUBLIC_QTANGL_API_BASE_URL=https://api.qtangl.com
