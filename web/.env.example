# Qtangl web (Next.js) — copy to .env.local for local dev. Never commit secrets.

# --- Public API ---
NEXT_PUBLIC_QTANGL_API_BASE_URL=http://127.0.0.1:8000
# NEXT_PUBLIC_QTANGL_SANDBOX_API_KEY=

# --- Dashboard WorkOS auth (set BOTH server + public on Vercel) ---
QTANGL_DASHBOARD_AUTH_WORKOS=true
NEXT_PUBLIC_QTANGL_DASHBOARD_AUTH_WORKOS=true
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback
QTANGL_BFF_SESSION_SECRET=

# --- Dashboard auth options ---
# QTANGL_DASHBOARD_AUTH_LEGACY_KEY=true
# QTANGL_DASHBOARD_REQUIRE_SSO=false
# NEXT_PUBLIC_QTANGL_DASHBOARD_AUTH_LEGACY_KEY=true

# --- App URLs ---
# NEXTAUTH_URL=http://localhost:3000
# QTANGL_PUBLIC_URL=http://localhost:3000
