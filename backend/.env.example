# Qtangl backend environment (copy to `.env` in repo root or export locally).
# Never commit real secrets.

# --- API ---
QTANGL_API_KEY=qtangl-demo-key
QTANGL_RATE_LIMIT_PER_MINUTE=300
QTANGL_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://www.qtangl.com,https://qtangl.com
# QTANGL_CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# --- Admin / tenants ---
# QTANGL_ADMIN_API_KEY=change-me-admin-key
# QTANGL_SIGNUP_PROVISION_SECRET=change-me-for-manual-monitor-provision

# --- PQC product ---
# QTANGL_PUBLIC_URL=https://www.qtangl.com
# QTANGL_REPORT_SIGNING_KEY_B64=  # stable Ed25519 key (base64); generate once
# QTANGL_SIGNING_KEY_FILE=        # optional file path for stable Ed25519 key
# QTANGL_ML_DSA_SECRET_B64=       # optional ML-DSA-65 primary signer
# QTANGL_ML_DSA_PUBLIC_B64=
# QTANGL_ML_DSA_KEY_FILE=         # optional file path for ML-DSA keypair
# QTANGL_ENABLE_TRANSPARENCY_LOG=false  # append-only hash log for signed reports
# Set true in production after smoke test (see scripts/verify_production_rollout.py)
# QTANGL_ENABLE_TRANSPARENCY_LOG=true
# QTANGL_RUN_MIGRATIONS_ON_START=true
# QTANGL_DB_AUTO_MIGRATE=false
# QTANGL_VERIFY_RATE_LIMIT_PER_MINUTE=60
# QTANGL_EVIDENCE_RETENTION_MONTHS=12
# QTANGL_TRANSPARENCY_ANCHOR_DIR=       # witness files for log root anchoring
# QTANGL_ANCHOR_INTERVAL=100           # anchor every N log entries
# QTANGL_ALERT_READINESS_DROP=5
# QTANGL_ALERT_EMAIL=ops@example.com

# --- PQC scanner ---
# QTANGL_PQC_ENABLE_LIVE_SCAN=false
# QTANGL_PQC_SCAN_ALLOWLIST=
# QTANGL_PQC_SCAN_TIMEOUT=30
# QTANGL_PQC_MAX_ENDPOINTS=25

# --- Monitoring / worker ---
# QTANGL_ENABLE_SCHEDULER=true
# QTANGL_SCHEDULER_INTERVAL_SEC=60
# QTANGL_INLINE_JOBS=true
# QTANGL_WORKER_MAX_RETRIES=3
# REDIS_URL=redis://localhost:6379/0

# --- Email ---
# QTANGL_SMTP_HOST=
# QTANGL_SMTP_PORT=587
# QTANGL_SMTP_USER=
# QTANGL_SMTP_PASSWORD=
# QTANGL_SMTP_FROM=reports@qtangl.com

# --- Stripe (Monitor self-serve) ---
# QTANGL_STRIPE_SECRET_KEY=
# QTANGL_STRIPE_MONITOR_PRICE_ID=
# QTANGL_STRIPE_WEBHOOK_SECRET=
# Events: checkout.session.completed, customer.subscription.updated/deleted, invoice.payment_failed

# --- Onboarding drip (mini-assessment) ---
# Wired via POST /public/lead-capture from /assess/mini; worker sends steps 2–5

# --- Classical solver ---
QTANGL_CLASSICAL_TIMEOUT_SECONDS=5
QTANGL_SOLVER_WORKERS=8

# --- QAOA (local/research only; keep false on Railway production) ---
QTANGL_ENABLE_QAOA=false

# --- Deploy ---
# PORT=8000
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/qtangl
# QTANGL_DB_AUTO_MIGRATE=true
