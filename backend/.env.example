# Qtangl backend environment (copy to `.env` in repo root or export locally).
# Never commit real secrets.

# --- API ---
QTANGL_API_KEY=qtangl-demo-key
QTANGL_RATE_LIMIT_PER_MINUTE=120
QTANGL_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# QTANGL_CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# --- Classical solver ---
QTANGL_CLASSICAL_TIMEOUT_SECONDS=5
QTANGL_SOLVER_WORKERS=8

# --- QAOA (local/research only; keep false on Railway production) ---
QTANGL_ENABLE_QAOA=false
# QTANGL_QAOA_MAX_BINARY_VARIABLES=12
# QTANGL_QAOA_MAX_HORIZON=6
# QTANGL_QAOA_MAX_OVERLAP_CONSTRAINTS=24
# QTANGL_QAOA_REPS=1
# QTANGL_QAOA_MAXITER=12
# QTANGL_QAOA_SHOTS=256
# QTANGL_QAOA_SEED=1234
# QTANGL_QAOA_SIMULATOR_METHOD=matrix_product_state

# --- PQC scanner ---
# QTANGL_PQC_ENABLE_LIVE_SCAN=false  # default off; set true only for authorized live scans
# QTANGL_PQC_DATA_DIR=
# QTANGL_PQC_SCAN_ALLOWLIST=
# QTANGL_PQC_ENABLE_OQS=false
# QTANGL_OQS_DEMO_SERVER=test.openquantumsafe.org
# QTANGL_PQC_SCAN_TIMEOUT=30
# QTANGL_PQC_MAX_ENDPOINTS=25

# --- IBM Quantum (offline trace capture only) ---
# QISKIT_IBM_TOKEN=
# QISKIT_IBM_INSTANCE=

# --- Deploy ---
# PORT=8000
# RAILWAY_ENVIRONMENT=
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/qtangl
# REDIS_URL=redis://localhost:6379/0
# QTANGL_DB_AUTO_MIGRATE=true
