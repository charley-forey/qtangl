# Qtangl backend environment (copy to `.env` in repo root or export locally).
# Never commit real secrets.

# --- API ---
QTANGL_API_KEY=qtangl-demo-key
# QTANGL_DISCOVERY_ENABLE_ALL=true  # dev: enable host/code/binary discovery flags for all tenants
# DISCOVERY_MTLS_REQUIRED=false     # production: true — require X-Qtangl-Agent-Cert on agent endpoints
# DISCOVERY_CA_KEY_PEM=               # internal CA private key (PEM); auto-generated in dev if unset
# DISCOVERY_CA_CERT_PEM=              # internal CA certificate (PEM)
# DISCOVERY_AGENT_CERT_TTL_DAYS=90
# GITHUB_APP_SLUG=qtangl-discovery
# GITHUB_APP_WEBHOOK_SECRET=
# SERVICENOW_INSTANCE=
# SERVICENOW_USER=
# SERVICENOW_PASSWORD=
QTANGL_RATE_LIMIT_PER_MINUTE=300
QTANGL_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://www.qtangl.com,https://qtangl.com
# QTANGL_CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# --- Admin / tenants ---
# QTANGL_ADMIN_API_KEY=change-me-admin-key
# QTANGL_SIGNUP_PROVISION_SECRET=change-me-for-manual-monitor-provision

# --- PQC product ---
# QTANGL_PUBLIC_URL=https://www.qtangl.com  # web app origin for verify/email links — NOT api.qtangl.com
# QTANGL_REPORT_SIGNING_KEY_B64=  # stable Ed25519 key (base64); generate once
# QTANGL_SIGNING_KEY_FILE=        # optional file path for stable Ed25519 key
# QTANGL_ML_DSA_SECRET_B64=       # optional ML-DSA-65 primary signer
# QTANGL_ML_DSA_PUBLIC_B64=
# QTANGL_ML_DSA_KEY_FILE=         # optional file path for ML-DSA keypair
# QTANGL_ENABLE_TRANSPARENCY_LOG=false  # append-only hash log for signed reports
# Set true in production after smoke test (see scripts/verify_production_rollout.py)
# QTANGL_ENABLE_TRANSPARENCY_LOG=true
# QTANGL_RUN_MIGRATIONS_ON_START=true
# QTANGL_DB_AUTO_MIGRATE=false
# QTANGL_VERIFY_RATE_LIMIT_PER_MINUTE=60
# QTANGL_EVIDENCE_RETENTION_MONTHS=12
# QTANGL_TRANSPARENCY_ANCHOR_DIR=       # witness files for log root anchoring
# QTANGL_ANCHOR_INTERVAL=100           # anchor every N log entries
# QTANGL_ANCHOR_EVERY_ENTRY=false
# QTANGL_ANCHOR_SCHEDULE_HOURS=24      # scheduled anchor + drift check
# QTANGL_ANCHOR_GIT_REPO=org/qtangl-transparency-anchors
# QTANGL_ANCHOR_GIT_TOKEN=
# QTANGL_ANCHOR_GIT_BRANCH=main
# QTANGL_ANCHOR_TSA_URL=https://freetsa.org/tsr
# QTANGL_ANCHOR_TSA_CERT=              # PEM path for TSA cert validation
# QTANGL_SIGNING_ALGS=ml-dsa-65,ed25519
# QTANGL_VERIFY_POLICY=any             # any | all
# QTANGL_SIGNING_KMS_PROVIDER=none     # none | aws | azure
# QTANGL_SIGNING_KMS_KEY_ID=
# QTANGL_SIGNING_KEY_ENC_B64=
# QTANGL_SIGNING_KMS_NATIVE=false
# QTANGL_INDEX_ENABLED=true
# QTANGL_INDEX_MIN_COHORT=10
# QTANGL_EVIDENCE_BACKUP_BUCKET=
# QTANGL_ALERT_READINESS_DROP=5
# QTANGL_ALERT_EMAIL=ops@example.com

# --- PQC scanner ---
# QTANGL_PQC_ENABLE_LIVE_SCAN=false
# QTANGL_PQC_SCAN_ALLOWLIST=qtangl.com,www.qtangl.com,api.qtangl.com
# QTANGL_PQC_SCAN_TIMEOUT=30
# QTANGL_PQC_MAX_ENDPOINTS=25

# --- Dogfood / trust center self-scan ---
# Dedicated tenant for public GET /pqc/dogfood/latest (not shared sandbox key)
# QTANGL_DOGFOOD_TENANT_ID=dogfood
# GitHub secret QTANGL_DOGFOOD_API_KEY — dogfood tenant API key for live-dogfood CI

# --- Monitoring / worker ---
# QTANGL_ENABLE_SCHEDULER=true
# QTANGL_SCHEDULER_INTERVAL_SEC=60
# QTANGL_INLINE_JOBS=true
# QTANGL_WORKER_MAX_RETRIES=3
# REDIS_URL=redis://localhost:6379/0

# --- Email (API + worker — weekly digest, board exports, alerts) ---
# QTANGL_SMTP_HOST=
# QTANGL_SMTP_PORT=587
# QTANGL_SMTP_USER=
# QTANGL_SMTP_PASSWORD=
# QTANGL_SMTP_FROM=reports@qtangl.com

# --- Stripe (Monitor self-serve) ---
# QTANGL_STRIPE_SECRET_KEY=
# QTANGL_STRIPE_MONITOR_PRICE_ID=
# QTANGL_STRIPE_CONVERT_PRICE_ID=
# QTANGL_STRIPE_ENTERPRISE_PRICE_ID=
# QTANGL_STRIPE_WEBHOOK_SECRET=
# Events: checkout.session.completed, customer.subscription.updated/deleted, invoice.payment_failed

# --- Convert / remediation automation ---
# QTANGL_ACME_DIRECTORY_URL=https://acme-staging-v02.api.letsencrypt.org/directory
# GITHUB_TOKEN=                    # hybrid TLS PR automation
# DEPENDENCY_TRACK_BASE_URL=
# DEPENDENCY_TRACK_API_KEY=

# --- Classical solver ---
QTANGL_CLASSICAL_TIMEOUT_SECONDS=5
QTANGL_SOLVER_WORKERS=8

# --- QAOA (local/research only; keep false on Railway production) ---
QTANGL_ENABLE_QAOA=false

# --- Deploy (production — required for Monitor tier) ---
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/qtangl
# REDIS_URL=redis://default:pass@host:6379/0
# QTANGL_DB_AUTO_MIGRATE=true
# QTANGL_SECRETS_KEY=          # Fernet key for encrypted onboarding tokens + integration secrets
# QTANGL_ENABLE_TRANSPARENCY_LOG=true
# QTANGL_ENABLE_SCHEDULER=true
# QTANGL_INLINE_JOBS=false

# --- Dashboard auth (WorkOS) ---
# WORKOS_API_KEY=
# WORKOS_CLIENT_ID=
# WORKOS_WEBHOOK_SECRET=
# WORKOS_COOKIE_PASSWORD=          # 32+ chars for AuthKit session seal (web)
# QTANGL_BFF_SESSION_SECRET=       # HMAC secret for BFF → backend session headers
# QTANGL_DASHBOARD_AUTH_WORKOS=true
# QTANGL_DASHBOARD_AUTH_LEGACY_KEY=true   # allow API key paste during migration
# QTANGL_DASHBOARD_REQUIRE_SSO=false     # global default; enterprise tenants override per-tenant
# QTANGL_ONBOARDING_V2=false             # onboarding returns login URL instead of raw API key
# QTANGL_DASHBOARD_SUMMARY_WARN_MS=800   # log warning when summary exceeds threshold
# Email for digests/board exports: use QTANGL_SMTP_* block above (worker + API processes).
