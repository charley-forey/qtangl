{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "QtanglReadOnlyACM",
      "Effect": "Allow",
      "Action": [
        "acm:ListCertificates",
        "acm:DescribeCertificate",
        "acm:ListTagsForCertificate"
      ],
      "Resource": "*"
    },
    {
      "Sid": "QtanglReadOnlyKMSMetadata",
      "Effect": "Allow",
      "Action": [
        "kms:ListKeys",
        "kms:DescribeKey",
        "kms:ListAliases",
        "kms:GetKeyRotationStatus"
      ],
      "Resource": "*"
    },
    {
      "Sid": "QtanglDenyKeyMaterial",
      "Effect": "Deny",
      "Action": [
        "kms:Decrypt",
        "kms:GenerateDataKey*",
        "kms:Sign",
        "secretsmanager:GetSecretValue"
      ],
      "Resource": "*"
    }
  ]
}
