{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "QtanglKmsFlipAllow",
      "Effect": "Allow",
      "Action": [
        "kms:CreateKey",
        "kms:CreateAlias",
        "kms:UpdateAlias",
        "kms:TagResource",
        "kms:EnableKeyRotation",
        "kms:ScheduleKeyDeletion",
        "kms:DescribeKey",
        "kms:ListAliases"
      ],
      "Resource": "*"
    },
    {
      "Sid": "QtanglKmsFlipDenyKeyMaterial",
      "Effect": "Deny",
      "Action": [
        "kms:Decrypt",
        "kms:GenerateDataKey*",
        "kms:GetPublicKey",
        "kms:ExportKey"
      ],
      "Resource": "*"
    }
  ]
}
